#!/usr/bin/env python3
"""Launcher so the tool can be run as `./chartify`.

Keeps chartify.py importable as a module while giving the interactive flow a
name that needs no extension and no `python3` prefix.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from chartify import main

if __name__ == "__main__":
    raise SystemExit(main())
